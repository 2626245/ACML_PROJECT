# ================================================================
# ACML Project — Pneumonia Detection from Chest X-Rays
# Variation 1: Custom CNN with Batch Normalisation
#
# main.py — Runs everything in order.
#
# This is the only file you need to run:
#   python main.py
#
# Make sure chest_xray_processed/ is in the same folder.
# ================================================================

import tensorflow as tf
print("TensorFlow version:", tf.__version__)

from data     import get_generators
from model    import build_model
from train    import train_model, plot_history
from evaluate import evaluate_model, plot_confusion_matrix, plot_roc_curve


# ---------------------------------------------------------------
# STEP 1 — Load data
# ---------------------------------------------------------------
train_gen, val_gen, test_gen = get_generators()

# ---------------------------------------------------------------
# STEP 2 — Build model
# ---------------------------------------------------------------
model = build_model()
model.summary()

# ---------------------------------------------------------------
# STEP 3 — Train model
# ---------------------------------------------------------------
history = train_model(model, train_gen, val_gen)
plot_history(history)

# ---------------------------------------------------------------
# STEP 4 — Evaluate on test set
# ---------------------------------------------------------------
y_true, y_pred, y_pred_prob, accuracy = evaluate_model(model, test_gen)
precision, recall, f1                 = plot_confusion_matrix(y_true, y_pred)
roc_auc                               = plot_roc_curve(y_true, y_pred_prob)

# ---------------------------------------------------------------
# STEP 5 — Final summary
# ---------------------------------------------------------------
print("=" * 55)
print("  VARIATION 1 — CUSTOM CNN — FINAL RESULTS SUMMARY")
print("=" * 55)
print(f"  Accuracy:  {accuracy*100:.2f}%")
print(f"  Precision: {precision:.4f}")
print(f"  Recall:    {recall:.4f}")
print(f"  F1 Score:  {f1:.4f}")
print(f"  AUC:       {roc_auc:.4f}")
print("=" * 55)
